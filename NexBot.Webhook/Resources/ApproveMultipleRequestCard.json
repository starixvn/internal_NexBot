{
    "type": "AdaptiveCard",
    "body": [
        {
            "type": "RichTextBlock",
            "spacing": "none",
            "inlines": [
                "Dear ",
                {
                    "type": "TextRun",
                    "text": "${ApproverNickname},",
                    "weight": "bolder"
                }
            ]
        },
        {
            "type": "RichTextBlock",
            "inlines": [
                "You have ",
                {
                    "type": "TextRun",
                    "text": "${TotalRequest} pending request(s)",
                    "weight": "bolder"
                },
                " awaiting for your approval. Please find at the following list:"
            ]
        },
        {
            "type": "Table",
            "firstRowAsHeader": true,
            "columns": [
                {
                    "width": 1
                }
            ],
            "rows": [
                {
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Requests",
                                    "wrap": true,
                                    "weight": "Bolder",
                                    "horizontalAlignment": "center"
                                }
                            ]
                        }
                    ],
                    "style": "accent"
                },
                {
                    "$data": "${Requests}",
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "center",
                            "items": [
                                {
                                    "type": "ColumnSet",
                                    "spacing": "medium",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "43px",
                                            "verticalContentAlignment": "center",
                                            "spacing": "none",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "url": "${Avatar}",
                                                    "altText": "${NickName}",
                                                    "size": "auto"
                                                }                                                
                                            ]
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "spacing": "small",
                                            "items": [
                                                {
                                                    "type": "RichTextBlock",
                                                    "inlines": [
                                                        {
                                                            "type": "TextRun",
                                                            "text": "${NickName}",
                                                            "weight": "bolder"
                                                        },
                                                        {
                                                            "type": "TextRun",
                                                            "text": " - request #${RequestId}",
                                                            "size": "small"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "RichTextBlock",
                                                    "spacing": "none",
                                                    "inlines": [
                                                        {
                                                            "type": "TextRun",
                                                            "text": "Created: ${CreatedDate}",
                                                            "italic": true,
                                                            "isSubtle": true,
                                                            "size": "small"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "RichTextBlock",
                                                    "spacing": "none",
                                                    "inlines": [
                                                        {
                                                            "type": "TextRun",
                                                            "text": "⭒ Type: "
                                                        },
                                                        {
                                                            "type": "TextRun",
                                                            "text": "${RequestType}",
                                                            "color": "${if(IsLeaveRequest == true, 'accent', 'good')}",
                                                            "weight": "bolder"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "RichTextBlock",
                                                    "spacing": "none",
                                                    "inlines": [
                                                        {
                                                            "type": "TextRun",
                                                            "text": "⭒ Date: "
                                                        },
                                                        {
                                                            "type": "TextRun",
                                                            "text": "${DateDetails} ",
                                                            "color": "${if(IsLeaveRequest == true, 'accent', 'good')}",
                                                            "weight": "bolder"
                                                        },
                                                        {
                                                            "type": "TextRun",
                                                            "$when": "${IsLeaveRequest == false}",
                                                            "text": "on "
                                                        },
                                                        {
                                                            "type": "TextRun",
                                                            "text": "${if(IsLeaveRequest == true, TotalDays, FromDate)}",
                                                            "isSubtle": "${IsLeaveRequest == true}",
                                                            "weight": "bolder"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "RichTextBlock",
                                                    "spacing": "none",
                                                    "$when": "${IsLeaveRequest == true}",
                                                    "inlines": [
                                                        {
                                                            "type": "TextRun",
                                                            "text": "⭒ Remark: ${Remark}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Column",
                                            "width": "20px",
                                            "spacing": "none",
                                            "items": [
                                                {
                                                    "type": "ActionSet",
                                                    "spacing": "none",
                                                    "actions": [
                                                        {
                                                            "type": "Action.Submit",
                                                            "style": "positive",
                                                            "title": "✅ Approve",
                                                            "mode": "secondary",
                                                            "data": {
                                                                "Type": 1,
                                                                "ResponseData": {
                                                                    "RequestId": "${RequestId}",
                                                                    "Command": "Approve",
                                                                    "CallBackUrl": "${CallbackUrl}",
                                                                    "ProcessedBy": "${ApproverId}"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "type": "Action.Submit",
                                                            "style": "destructive",
                                                            "title": "❌ Reject",
                                                            "mode": "secondary",
                                                            "data": {
                                                                "Type": 1,
                                                                "ResponseData": {
                                                                    "RequestId": "${RequestId}",
                                                                    "Command": "Reject",
                                                                    "CallBackUrl": "${CallbackUrl}",
                                                                    "ProcessedBy": "${ApproverId}"
                                                                }
                                                            }
                                                        }

                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.Submit",
            "style": "positive",
            "title": "✅ Approve All",
            "data": {
                "Type": 6,
                "ResponseData": {
                    "RequestIds": "${RequestIds}",
                    "Command": "Approve",
                    "CallBackUrl": "${CallbackUrl}",
                    "ProcessedBy": "${ApproverId}"
                }
            }
        },
        {
            "type": "Action.Submit",
            "style": "default",
            "title": "❌ Reject All",
            "data": {
                "Type": 6,
                "ResponseData": {
                    "RequestIds": "${RequestIds}",
                    "Command": "Reject",
                    "CallBackUrl": "${CallbackUrl}",
                    "ProcessedBy": "${ApproverId}"
                }
            }
        }
    ],
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6"
}