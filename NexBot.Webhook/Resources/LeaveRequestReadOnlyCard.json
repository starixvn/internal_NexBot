{
    "type": "AdaptiveCard",
    "body": [

        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "items": [
                        {
                            "type": "Image",
                            "style": "Person",
                            "url": "${AvatarUrl}",
                            "altText": "${Nick}",
                            "size": "Small"
                        }
                    ],
                    "width": "auto"
                },
                {
                    "type": "Column",
                    "items": [
                        {
                            "type": "TextBlock",
                            "weight": "Bolder",
                            "text": "${Nick}",
                            "wrap": true
                        },
                        {
                            "type": "TextBlock",
                            "spacing": "None",
                            "text": "${CreatedDate}",
                            "isSubtle": true,
                            "wrap": true
                        }
                    ],
                    "width": "stretch"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "Dear ${Supervisor}, This is to inform you about your member, ${Nick} (${FullName}) had a leave request (#${RequestId}):",
            "wrap": true
        },
        {
            "type": "FactSet",
            "facts": [
                {
                    "title": "- Date:",
                    "value": "${RequestDate}"
                },
                {
                    "title": "- Type:",
                    "value": "${LeaveType}"
                },
                {
                    "title": "- Remark:",
                    "value": "${Remark}"
                }
            ]
        }
    ],
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6"
}