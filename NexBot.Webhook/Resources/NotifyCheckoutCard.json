{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6",
    "body": [
        {
            "type": "TextBlock",
            "text": "✅ Checkout Successfully! ",
            "wrap": true,
            "style": "heading",
            "size": "large",
            "color": "good"
        },
        {
            "type": "TextBlock",
            "text": "Dear ${NickName}",
            "size": "Medium",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "This is a message to inform you just have a \"checkout\" record for today working on HRM system as bellow:",
            "size": "Medium",
            "wrap": true
        },
        {
            "type": "FactSet",
            "facts": [
                {
                    "title": "- Checkout time:",
                    "value": "${CheckoutTime}"
                },
                {
                    "title": "- Working hours:",
                    "value": "${TotalHours}"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.Submit",
            "title": "Stop receive checkout notification",
            "mode": "secondary",
            "style": "destructive",
            "data": {
                "Type": 4,
                "ResponseData": {
                }
            }
        }
    ]
}