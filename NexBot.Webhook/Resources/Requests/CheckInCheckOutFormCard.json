{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "RichTextBlock",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "🕗",
                    "size": "extraLarge",
                    "weight": "bolder"
                },
                {
                    "type": "TextRun",
                    "text": " Check In/Check Out Request",
                    "size": "large",
                    "weight": "bolder"
                }
            ]
        },
        {
            "type": "Input.ChoiceSet",
            "id": "requestType",
            "style": "compact",
            "label": "Request",
            "isMultiSelect": false,
            "isRequired": true,
            "placeholder": "---Choose Request Type---",
            "value": "${RequestType}",
            "choices": [
                {
                    "title": "Check In",
                    "value": "1"
                },
                {
                    "title": "Check Out",
                    "value": "2"
                }
            ]
        },
        {
            "type": "Input.Date",
            "id": "requestDate",
            "label": "Request date",
            "value": "2024-07-18",
            "isRequired": true
        },
        {
            "type": "Input.Time",
            "id": "time",
            "min": "08:00",
            "max": "24:00",
            "value": "17:00"
        }
    ],
    "actions": [
        {
            "type": "Action.Submit",
            "style": "positive",
            "title": "Submit"
        }
    ]
}