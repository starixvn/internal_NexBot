{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "RichTextBlock",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "🕗",
                    "size": "extraLarge",
                    "weight": "bolder"
                },
                {
                    "type": "TextRun",
                    "text": " Check In/Check Out Request",
                    "size": "large",
                    "weight": "bolder"
                }
            ]
        },
        {
            "type": "Input.ChoiceSet",
            "id": "MissingType",
            "style": "compact",
            "label": "Request",
            "isMultiSelect": false,
            "isRequired": true,
            "placeholder": "---Choose Request Type---",
            "value": "${MissingType}",
            "choices": [
                {
                    "title": "Check In",
                    "value": "1"
                },
                {
                    "title": "Check Out",
                    "value": "2"
                }
            ]
        },
        {
            "type": "Input.Date",
            "id": "RequestDate",
            "max": "${MaxDate}",
            "label": "Request date",
            "value": "${RequestDateString}",
            "isRequired": true
        },
        {
            "type": "Input.Time",
            "id": "RequestTime",
            "min": "08:00",
            "max": "24:00",
            "value": "${RequestTimeString}"
        },
        {
            "type": "RichTextBlock",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "Shift"
                },
                "         ",
                {
                    "type": "TextRun",
                    "text": "${Shift}",
                    "weight": "bolder",
                    "isSubtle": true
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.Submit",
            "style": "positive",
            "title": "Submit",
            "data": {
                "Type": 10,
                "FormId": 1,
                "EmpId": "${EmpId}"
            }
        }
    ]
}