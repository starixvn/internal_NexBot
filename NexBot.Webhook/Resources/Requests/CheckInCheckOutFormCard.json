{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.0",
    "body": [
        {
            "type": "RichTextBlock",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "🕗",
                    "size": "extraLarge",
                    "weight": "bolder"
                },
                {
                    "type": "TextRun",
                    "text": "New Check In Out Request",
                    "size": "large",
                    "color": "good",
                    "weight": "bolder"
                }
            ]
        },

        {
            "type": "Input.ChoiceSet",
            "id": "MissingType",
            "style": "compact",
            "label": "Missing Type",
            "isMultiSelect": false,
            "isRequired": true,
            "errorMessage": "This is a required input",
            "placeholder": "---Choose Request Type---",
            "value": "${MissingType}",
            "separator": true,
            "choices": [
                {
                    "title": "Check In",
                    "value": "1"
                },
                {
                    "title": "Check Out",
                    "value": "2"
                }
            ]
        },
        {
            "type": "Input.Date",
            "id": "RequestDate",
            "max": "${MaxDate}",
            "label": "Request date",
            "value": "${RequestDateString}",
            "errorMessage": "This is a required input",
            "isRequired": true,
            "separator": true
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": 1,
                    "items": [
                        {
                            "type": "Input.ChoiceSet",
                            "id": "Hour",
                            "label": "Hour",
                            "style": "compact",
                            "value": "${Hour}",
                            "isRequired": true,
                            "errorMessage": "This is a required input",
                            "choices": [
                                {
                                    "$data": "${HourArray}",
                                    "title": "${Display}",
                                    "value": "${Value}"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": 1,
                    "items": [
                        {
                            "type": "Input.ChoiceSet",
                            "id": "Minute",
                            "label": "Minute",
                            "style": "compact",
                            "value": "${Minute}",
                            "isRequired": true,
                            "errorMessage": "This is a required input",
                            "choices": [
                                {
                                    "$data": "${MinuteArray}",
                                    "title": "${Display}",
                                    "value": "${Value}"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "RichTextBlock",
            "separator": true,
            "spacing": "large",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "Shift"
                },
                "               ",
                {
                    "type": "TextRun",
                    "text": "${Shift}",
                    "weight": "bolder",
                    "isSubtle": true
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.Submit",
            "style": "positive",
            "title": "Submit",
            "data": {
                "Type": 10,
                "FormId": 1,
                "EmpId": "${EmpId}",
                "Shift": "${Shift}"
            }
        }
    ]
}