{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "ColumnSet",
            "bleed": true,
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "⚠️ Missing Time Log!",
                            "weight": "bolder",
                            "wrap": false,
                            "style": "heading",
                            "size": "Large",
                            "color": "attention"
                        }
                    ]
                }
            ]
        },
        {
            "type": "RichTextBlock",
            "inlines": [
                "Dear ",
                {
                    "type": "TextRun",
                    "text": "${LeaderName}",
                    "weight": "bolder"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "This is a message to inform that your team member(s) forgot to log time in ${LogMonth}:",
            "size": "Medium",
            "wrap": true
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "Container",
                    "items": "${MembersTextBlocks}"
                }
            ],
            "spacing": "medium"
        },
        {
            "type": "TextBlock",
            "text": "Please remind them to ensure accurate records.",
            "size": "Medium",
            "wrap": true
        }
    ]
}