{
    "text": ":clock8: NEW CHECK IN OUT REQUEST",
    "blocks": [
        {
            "type": "context",
            "elements": [
                {
                    "type": "image",
                    "image_url": "${AvatarUrl}",
                    "alt_text": "images"
                },
                {
                    "type": "mrkdwn",
                    "text": "*${Nick}* - ${CreatedDate}"
                }
            ]
        },
        {
            "type": "section",
            "text": {
                "type": "mrkdwn",
                "text": "This is to inform you that *${Nick}* (${FullName}) had a *${RequestType}* request (#${RequestId}):"
            }
        },
        {
            "type": "section",
            "fields": [
                {
                    "type": "mrkdwn",
                    "text": "*📅 Date:* ${RequestDate}"
                },
                {
                    "type": "mrkdwn",
                    "text": "*:pushpin: Shift:* ${Shift}"
                }
            ]
        },
        {
            "type": "section",
            "fields": [
                {
                    "type": "mrkdwn",
                    "text": "*:pencil: Time:* ${Time}"
                }
            ]
        },
        {
            "type": "divider"
        }
    ]
